# ── SUTRA configuration ──────────────────────────────────────────────
# Copy to .env and adjust. Values below are safe local-development defaults.

# PostgreSQL (the single datastore for the MVP — see docs/adr/002)
SUTRA_DATABASE_URL=postgresql+psycopg://localhost:5432/sutra

# JWT signing key — generate your own:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SUTRA_JWT_SECRET=change-me-local-dev-only
SUTRA_JWT_ACCESS_MINUTES=15
SUTRA_JWT_REFRESH_MINUTES=720

# HMAC key used to tokenise PII (phones, IDs, addresses) at ingest
SUTRA_PII_HMAC_KEY=change-me-local-dev-only

# Evidence packs: "local" writes to ./var/packs ; "s3" uses the S3 settings below
SUTRA_STORAGE_BACKEND=local
SUTRA_STORAGE_DIR=var/packs

# LLM (optional). Without a key SUTRA uses its deterministic narrative templates.
ANTHROPIC_API_KEY=
SUTRA_LLM_MODEL=claude-opus-5-5
# anthropic (API key) or bedrock (Claude in Amazon Bedrock, IAM auth, no key)
SUTRA_LLM_PROVIDER=anthropic
SUTRA_LLM_EFFORT=medium
SUTRA_LLM_ENABLED=true

# Synthetic data
SUTRA_SIM_SEED=42
SUTRA_SIM_SIZE=demo

# Frontend → backend (server-side only; the browser never sees the JWT)
SUTRA_API_URL=http://127.0.0.1:8000

# Demo users (seeded by `make seed`) share this local-only password.
SUTRA_DEMO_PASSWORD=sutra-demo

# ── Mock bank (Kestrel Bank) · MOCK BANK, TEST ENVIRONMENT, NO REAL MONEY ─────────────────────────
# The mock bank's screens (/bank) and API (/api/v1/bank) exist only in demo mode, the local default.
# Staging and production refuse to start in demo mode, so the mock bank can never run there.
# No other setting is needed: the bank writes straight into SUTRA's evidence store. See docs/mock-bank.
SUTRA_DEMO_MODE=true
